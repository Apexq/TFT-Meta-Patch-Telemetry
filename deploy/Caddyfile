# Caddy reverse proxy configuration for TFT AI Coach (v2 ASGI + SSE Streaming)
# Replace {$APP_DOMAIN} with your production domain (e.g. coach.example.com)

{$APP_DOMAIN:localhost} {
    encode gzip

    # Ensure Server-Sent Events (/chat/stream/) flush tokens immediately with zero buffering
    reverse_proxy app:8000 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }
}
