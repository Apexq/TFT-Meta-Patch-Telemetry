# Riot Games Developer API Key (https://developer.riotgames.com/)
# Enables direct regional Challenger / Grandmaster / Master ladder verification
RIOT_API_KEY=RGAPI-your-api-key-here

# Target Riot Server Region (tr1, euw1, na1, kr, eun1)
RIOT_PLATFORM_REGION=tr1
RIOT_ROUTING_REGION=europe

# Optional: Discord Webhook URL for automated patch & meta embeds
DISCORD_WEBHOOK_URL=
