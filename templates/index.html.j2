<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TFT Set 18 Meta & Patch Telemetry | {{ report.versions.latest_label }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #0a0e17;
      --bg-surface: #121722;
      --bg-elevated: #182030;
      --bg-inset: #0d121c;
      --border-subtle: #222d42;
      --border-hover: #3b4b6c;
      --accent-gold: #f0c374;
      --accent-gold-hover: #ffd98f;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-base);
      color: #f1f5f9;
      -webkit-font-smoothing: antialiased;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }
    /* Authentic TFT unit cost borders - radiant & high contrast */
    .cost-1 { border-color: #94a3b8; }
    .cost-2 { border-color: #22c55e; }
    .cost-3 { border-color: #38bdf8; }
    .cost-4 { border-color: #c084fc; }
    .cost-5, .cost-6 { border-color: #fbbf24; }

    .surface-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
    }
    .surface-card:hover {
      border-color: var(--border-hover);
    }
    .header-blur {
      background: rgba(10, 14, 23, 0.92);
      backdrop-filter: blur(12px);
    }
    .ad-slot-container {
      background: repeating-linear-gradient(
        -45deg,
        rgba(24, 32, 48, 0.45),
        rgba(24, 32, 48, 0.45) 10px,
        rgba(18, 23, 34, 0.45) 10px,
        rgba(18, 23, 34, 0.45) 20px
      );
      border: 1px dashed #2b3952;
    }
    html[data-lang="tr"] .lang-en { display: none !important; }
    html[data-lang="en"] .lang-tr { display: none !important; }
  </style>
  <script>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const queryLang = urlParams.get('lang');
      const storedLang = localStorage.getItem('tft_lang');
      const browserLang = (navigator.language || '').toLowerCase().startsWith('tr') ? 'tr' : 'en';
      const initialLang = (queryLang === 'en' || queryLang === 'tr') ? queryLang : (storedLang || browserLang);
      document.documentElement.setAttribute('data-lang', initialLang);
    })();
  </script>
</head>
<body class="min-h-screen selection:bg-zinc-200 selection:text-zinc-950">

  <!-- Top Navigation Header -->
  <header class="border-b border-[#222d42] sticky top-0 z-30 header-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-9 h-9 rounded-md bg-[#182030] border border-[#29364f] flex items-center justify-center font-bold text-sm text-[#f0c374] mono shadow-inner">
          S18
        </div>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">
              <span class="lang-tr">TFT Set 18 Meta & Yama Telemetrisi</span>
              <span class="lang-en">TFT Set 18 Meta & Patch Telemetry</span>
            </h1>
            <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-slate-900 text-[#f0c374] border border-[#29364f] mono">
              {{ report.versions.latest_label }}
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            <span class="lang-tr">Master+ Kümeleme Analizi ({{ "{:,}".format(report.live_meta.matches_analyzed) }} Maç) &bull; BiS Eşya Dizilimleri &bull; CDragon Yama Diff</span>
            <span class="lang-en">Master+ Match Clustering ({{ "{:,}".format(report.live_meta.matches_analyzed) }} Matches) &bull; Carry BiS Builds &bull; CDragon Patch Diff</span>
          </p>
        </div>
      </div>

      <!-- Status Indicators & Language Switcher -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <div class="px-2.5 py-1 rounded bg-[#161e2e] border border-[#222d42] text-slate-300 flex items-center gap-1.5">
          <span class="text-slate-400">
            <span class="lang-tr">Yama:</span>
            <span class="lang-en">Patch:</span>
          </span>
          <span class="text-slate-100 font-semibold mono">{{ report.versions.previous_label }} &rarr; {{ report.versions.latest_label }}</span>
        </div>

        <div class="px-2.5 py-1 rounded bg-[#161e2e] border border-[#222d42] text-slate-300 flex items-center gap-1.5">
          <span class="text-slate-400">PBE:</span>
          <span class="text-amber-300 font-semibold mono">{{ report.versions.pbe_label }}</span>
        </div>

        <div class="px-2.5 py-1 rounded bg-[#161e2e] border border-[#222d42] text-slate-400 mono hidden sm:block">
          {{ report.generated_at }}
        </div>

        <!-- TR / EN Language Switcher -->
        <div class="inline-flex rounded bg-[#161e2e] p-0.5 border border-[#29364f] ml-1">
          <button id="lang-btn-tr" onclick="setLanguage('tr')" class="px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors">
            TR
          </button>
          <button id="lang-btn-en" onclick="setLanguage('en')" class="px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors">
            EN
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- ================================================================= -->
    <!-- AD SLOT 1: TOP LEADERBOARD (728x90 Desktop / 320x50 Mobile)        -->
    <!-- Replace inner content with Google AdSense / NitroPay / Venatus tag -->
    <!-- ================================================================= -->
    <aside id="ad-slot-header-leaderboard" aria-label="Sponsored Placement" class="ad-slot-container rounded-lg p-3 flex flex-col items-center justify-center min-h-[90px] text-center">
      <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mb-1">
        <span class="lang-tr">Sponsor / Reklam Alanı &bull; IAB Leaderboard (728&times;90)</span>
        <span class="lang-en">Sponsored Placement &bull; IAB Leaderboard (728&times;90)</span>
      </span>
      <p class="text-xs text-slate-400 max-w-lg">
        <span class="lang-tr">Google AdSense, NitroPay veya Venatus reklam birimi için ayrılmış üst banner alanı.</span>
        <span class="lang-en">Reserved header leaderboard container ready for Google AdSense, NitroPay, or Venatus ad tags.</span>
      </p>
    </aside>

    <!-- Navigation Bar: Lifecycle Mode Switcher + Live API Telemetry -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-[#222d42] pb-4">
      <div class="inline-flex flex-wrap rounded-lg bg-[#121722] p-1 border border-[#222d42] self-start gap-1">
        <button id="btn-tab-live" onclick="switchTab('live')"
          class="px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all bg-zinc-100 text-zinc-950 shadow-sm flex items-center gap-1.5">
          <span class="lang-tr">Canlı Yama &amp; Meta ({{ report.versions.latest_label }})</span>
          <span class="lang-en">Live Patch &amp; Meta ({{ report.versions.latest_label }})</span>
        </button>
        <button id="btn-tab-tierlist" onclick="switchTab('tierlist')"
          class="px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-slate-100 flex items-center gap-1.5">
          <span class="lang-tr">Eşya &amp; Şampiyon Tier Listesi</span>
          <span class="lang-en">Item &amp; Unit Tier List</span>
        </button>
        <button id="btn-tab-leaderboard" onclick="switchTab('leaderboard')"
          class="px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-slate-100 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#f0c374]"></span>
          <span class="lang-tr">Liderlik Tablosu (TR / EMEA / NA / KR)</span>
          <span class="lang-en">Leaderboards (TR / EMEA / NA / KR)</span>
        </button>
        <button id="btn-tab-pbe" onclick="switchTab('pbe')"
          class="px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-slate-100 flex items-center gap-1.5">
          <span class="lang-tr">PBE Erken Bakış ({{ report.versions.pbe_label }})</span>
          <span class="lang-en">PBE Early Preview ({{ report.versions.pbe_label }})</span>
        </button>
      </div>

      <div class="text-xs text-slate-300 flex flex-wrap items-center gap-2.5">
        <a href="https://www.metatft.com" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 px-2.5 py-1 rounded bg-[#121722] border border-[#222d42] hover:border-[#f0c374]/60 transition-colors group">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="lang-tr text-slate-200">Master+ Kümeleme Verisi: <strong class="text-white group-hover:text-[#f0c374] underline underline-offset-2">MetaTFT.com</strong></span>
          <span class="lang-en text-slate-200">Master+ Telemetry Provided by <strong class="text-white group-hover:text-[#f0c374] underline underline-offset-2">MetaTFT.com</strong></span>
        </a>
        {% if report.live_meta.riot_official_api and report.live_meta.riot_official_api.connected %}
        <div class="px-2.5 py-1 rounded bg-[#121722] border border-[#29364f] text-slate-200 flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#f0c374]"></span>
          <span class="lang-tr">{{ report.live_meta.riot_official_api.status_tr }}</span>
          <span class="lang-en">{{ report.live_meta.riot_official_api.status_en }}</span>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- TAB 1: LIVE PATCH & MASTER+ META ANALYSIS                         -->
    <!-- ================================================================= -->
    <div id="panel-live" class="space-y-8">

      <!-- Executive Briefing Card -->
      <section class="surface-card rounded-xl p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-4 rounded-sm bg-[#f0c374]"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">
              <span class="lang-tr">{{ report.ai_summary.engine }}</span>
              <span class="lang-en">{{ report.ai_summary.engine_en or report.ai_summary.engine }}</span>
            </span>
          </div>
          <span class="text-xs text-slate-400 mono">
            <span class="lang-tr">{{ "{:,}".format(report.live_meta.matches_analyzed) }} Master+ Maç Örneklemi</span>
            <span class="lang-en">{{ "{:,}".format(report.live_meta.matches_analyzed) }} Master+ Matches Sampled</span>
          </span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-white mb-2">
          <span class="lang-tr">{{ report.ai_summary.live_headline }}</span>
          <span class="lang-en">{{ report.ai_summary.live_headline_en or report.ai_summary.live_headline }}</span>
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          <span class="lang-tr">{{ report.ai_summary.live_analysis }}</span>
          <span class="lang-en">{{ report.ai_summary.live_analysis_en or report.ai_summary.live_analysis }}</span>
        </p>
      </section>

      <!-- Key Telemetry Metrics -->
      <section class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="surface-card rounded-xl p-4">
          <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
            <span class="lang-tr">İncelenen Master+ Maç</span>
            <span class="lang-en">Master+ Matches</span>
          </p>
          <p class="text-2xl sm:text-3xl font-bold text-white mt-1.5 mono">{{ "{:,}".format(report.live_meta.matches_analyzed) }}</p>
          <p class="text-xs text-slate-400 mt-1">Challenger, GM & Master ({{ report.versions.latest_label }})</p>
        </div>

        <div class="surface-card rounded-xl p-4">
          <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
            <span class="lang-tr">Yamada Buff Alanlar</span>
            <span class="lang-en">Patch Buffs</span>
          </p>
          <p class="text-2xl sm:text-3xl font-bold text-emerald-400 mt-1.5 mono">+{{ report.live_diff.summary_counts.buffed_champions + report.live_diff.summary_counts.buffed_traits }}</p>
          <p class="text-xs text-slate-400 mt-1">
            <span class="lang-tr">{{ report.live_diff.summary_counts.buffed_champions }} Şampiyon, {{ report.live_diff.summary_counts.buffed_traits }} Özellik</span>
            <span class="lang-en">{{ report.live_diff.summary_counts.buffed_champions }} Champions, {{ report.live_diff.summary_counts.buffed_traits }} Traits</span>
          </p>
        </div>

        <div class="surface-card rounded-xl p-4">
          <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
            <span class="lang-tr">Yamada Nerf Alanlar</span>
            <span class="lang-en">Patch Nerfs</span>
          </p>
          <p class="text-2xl sm:text-3xl font-bold text-rose-400 mt-1.5 mono">-{{ report.live_diff.summary_counts.nerfed_champions + report.live_diff.summary_counts.nerfed_traits }}</p>
          <p class="text-xs text-slate-400 mt-1">
            <span class="lang-tr">{{ report.live_diff.summary_counts.nerfed_champions }} Şampiyon, {{ report.live_diff.summary_counts.nerfed_traits }} Özellik</span>
            <span class="lang-en">{{ report.live_diff.summary_counts.nerfed_champions }} Champions, {{ report.live_diff.summary_counts.nerfed_traits }} Traits</span>
          </p>
        </div>

        <div class="surface-card rounded-xl p-4">
          <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
            <span class="lang-tr">Yama Etkisi Pozitif Komplar</span>
            <span class="lang-en">Positive Delta Comps</span>
          </p>
          <p class="text-2xl sm:text-3xl font-bold text-[#f0c374] mt-1.5 mono">{{ report.live_meta.rising_comps_count }} / {{ report.live_meta.total_comps }}</p>
          <p class="text-xs text-slate-400 mt-1">
            <span class="lang-tr">Net yama skoru &gt; 0 olan desteler</span>
            <span class="lang-en">Archetypes with net positive patch score</span>
          </p>
        </div>
      </section>

      <!-- Master+ Meta Compositions & BiS Section -->
      <section class="space-y-4">

        <!-- FEATURE 1: INTERACTIVE ITEM-TO-COMP MATCHER ("ELİMDEKİ EŞYAYLA NE OYNANIR?") -->
        {% if report.tier_lists and report.tier_lists.matcher_items %}
        <div class="surface-card rounded-xl p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-4 rounded-sm bg-[#f0c374]"></span>
                <h4 class="text-sm font-bold text-white">
                  <span class="lang-tr">Elimdeki Eşyayla Ne Oynanır? (İnteraktif Eşyadan Komp Bulucu)</span>
                  <span class="lang-en">What Should I Play With My Items? (Interactive Item-to-Comp Matcher)</span>
                </h4>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">Elindeki 1 ila 3 eşyaya tıkla; o eşyaları BiS (En İyi Eşya) olarak kullanan Master+ desteleri anında filtrelensin.</span>
                <span class="lang-en">Click 1 to 3 items you hold in-game to immediately filter Master+ compositions that use them as Best-in-Slot.</span>
              </p>
            </div>
            <button id="clear-items-btn" onclick="clearSelectedItems()" class="hidden self-start sm:self-auto px-2.5 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-100 hover:bg-zinc-700 transition-colors">
              <span class="lang-tr">Seçimi Temizle &times;</span>
              <span class="lang-en">Clear Items &times;</span>
            </button>
          </div>

          <div class="flex flex-wrap items-center gap-2" id="matcher-item-bar">
            {% for mit in report.tier_lists.matcher_items %}
            <button type="button" data-item-id="{{ mit.apiName }}" onclick="toggleItemMatcher('{{ mit.apiName }}')"
              title="{{ mit.name }} / {{ mit.name_en }} (Avg: #{{ mit.avg_place }})"
              class="matcher-item-btn group relative flex items-center gap-1.5 px-2 py-1 rounded-lg bg-[#0d121c] border border-[#222d42] hover:border-slate-500 transition-all text-xs">
              <img src="{{ mit.icon }}" alt="{{ mit.name }}" class="w-6 h-6 rounded-sm object-cover" onerror="this.style.display='none'" />
              <span class="text-[11px] text-slate-200 group-hover:text-white max-w-[110px] truncate hidden md:inline">
                <span class="lang-tr">{{ mit.name }}</span>
                <span class="lang-en">{{ mit.name_en }}</span>
              </span>
            </button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">
              <span class="lang-tr">Set 18 Master+ Meta Kompozisyonları & En İyi Eşyalar (BiS)</span>
              <span class="lang-en">Set 18 Master+ Meta Compositions & Carry Best-in-Slot (BiS) Items</span>
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">
              <span class="lang-tr">Master+ ortalama bitiriş sırasına göre dizilmiştir; {{ report.versions.previous_label }} &rarr; {{ report.versions.latest_label }} CDragon yama etki puanları entegre edilmiştir.</span>
              <span class="lang-en">Ordered by Master+ average placement and overlaid with {{ report.versions.previous_label }} &rarr; {{ report.versions.latest_label }} CDragon patch delta scores.</span>
            </p>
          </div>

          <!-- Search + Tier Filter Controls -->
          <div class="flex flex-wrap items-center gap-2">
            <div class="relative">
              <input id="comp-search-input" type="text" oninput="applyCompFilters()"
                placeholder="Search unit, trait, item..."
                class="bg-[#121722] border border-[#222d42] focus:border-slate-500 rounded-lg px-3 py-1.5 text-xs text-slate-100 placeholder-slate-400 outline-none w-48 sm:w-56 transition-colors" />
            </div>

            <div class="inline-flex flex-wrap rounded-lg bg-[#121722] p-1 border border-[#222d42] text-xs gap-1" id="comp-filter-bar">
              <button data-filter="ALL" onclick="filterComps('ALL')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold bg-zinc-200 text-zinc-950">
                <span class="lang-tr">Tümü ({{ report.live_meta.compositions | length }})</span>
                <span class="lang-en">All ({{ report.live_meta.compositions | length }})</span>
              </button>
              <button data-filter="S" onclick="filterComps('S')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-amber-400 hover:bg-slate-800/70">S</button>
              <button data-filter="A" onclick="filterComps('A')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-slate-200 hover:bg-slate-800/70">A</button>
              <button data-filter="B" onclick="filterComps('B')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-slate-300 hover:bg-slate-800/70">B</button>
              <button data-filter="C" onclick="filterComps('C')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-slate-400 hover:bg-slate-800/70">C</button>
              <button data-filter="YÜKSELEN" onclick="filterComps('YÜKSELEN')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-emerald-400 hover:bg-slate-800/70">
                <span class="lang-tr">&uarr; Buff</span>
                <span class="lang-en">&uarr; Buffed</span>
              </button>
              <button data-filter="DÜŞEN" onclick="filterComps('DÜŞEN')" class="comp-filter-btn px-2.5 py-1 rounded font-semibold text-rose-400 hover:bg-slate-800/70">
                <span class="lang-tr">&darr; Nerf</span>
                <span class="lang-en">&darr; Nerfed</span>
              </button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3" id="live-comp-grid">
          {% for comp in report.live_meta.compositions %}
          <div data-tier="{{ comp.tier }}" data-status="{{ comp.meta_status }}"
               data-items="{{ (comp.comp_item_ids or []) | join(',') }}"
               data-search="{{ (comp.comp_name ~ ' ' ~ (comp.comp_name_en or '') ~ ' ' ~ (comp.active_traits | join(' ')) ~ ' ' ~ ((comp.active_traits_en or []) | join(' ')) ~ ' ' ~ (comp.units | map(attribute='name') | join(' ')) ~ ' ' ~ (comp.units | map(attribute='name_en') | join(' '))) | lower }}"
               class="comp-card surface-card rounded-xl p-4 sm:p-5 transition-colors">
            <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">

              <!-- Left: Tier Badge + Archetype Details -->
              <div class="flex items-start sm:items-center gap-3.5 min-w-[285px]">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center font-bold text-base shrink-0 mono
                  {% if comp.tier == 'S' %}bg-amber-500/20 text-amber-300 border border-amber-500/50 shadow-sm
                  {% elif comp.tier == 'A' %}bg-purple-500/20 text-purple-200 border border-purple-500/40 shadow-sm
                  {% elif comp.tier == 'B' %}bg-blue-500/20 text-blue-200 border border-blue-500/40 shadow-sm
                  {% else %}bg-slate-800 text-slate-300 border border-slate-700{% endif %}">
                  {{ comp.tier }}
                </div>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h4 class="text-sm sm:text-base font-bold text-white">
                      <span class="lang-tr">{{ comp.comp_name }}</span>
                      <span class="lang-en">{{ comp.comp_name_en or comp.comp_name }}</span>
                    </h4>
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-[#182030] text-slate-200 border border-[#29364f] mono">
                      {{ comp.levelling }} &bull; {{ comp.unit_count }}
                      <span class="lang-tr">Birim</span><span class="lang-en">Units</span>
                    </span>
                    {% if comp.comp_delta_score != 0 %}
                    <span class="px-2 py-0.5 text-[11px] font-semibold rounded mono
                      {% if comp.meta_status == 'YÜKSELEN' %}bg-emerald-950/70 text-emerald-300 border border-emerald-500/40
                      {% elif comp.meta_status == 'DÜŞEN' %}bg-rose-950/70 text-rose-300 border border-rose-500/40
                      {% else %}bg-[#182030] text-slate-300 border border-[#2b3952]{% endif %}">
                      <span class="lang-tr">Yama: {{ '%+.1f'|format(comp.comp_delta_score) }}</span>
                      <span class="lang-en">Delta: {{ '%+.1f'|format(comp.comp_delta_score) }}</span>
                    </span>
                    {% endif %}
                  </div>

                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-slate-400">
                    <span>
                      <span class="lang-tr"><strong class="text-slate-300 font-medium">{{ comp.active_traits | join(' · ') }}</strong></span>
                      <span class="lang-en"><strong class="text-slate-300 font-medium">{{ (comp.active_traits_en or comp.active_traits) | join(' · ') }}</strong></span>
                    </span>
                    {% if comp.buffed_units or comp.buffed_traits %}
                    <span class="text-emerald-300">
                      <span class="lang-tr">+ {{ (comp.buffed_units + comp.buffed_traits) | join(', ') }}</span>
                      <span class="lang-en">+ {{ ((comp.buffed_units_en or comp.buffed_units) + (comp.buffed_traits_en or comp.buffed_traits)) | join(', ') }}</span>
                    </span>
                    {% endif %}
                    {% if comp.nerfed_units or comp.nerfed_traits %}
                    <span class="text-rose-300">
                      <span class="lang-tr">&minus; {{ (comp.nerfed_units + comp.nerfed_traits) | join(', ') }}</span>
                      <span class="lang-en">&minus; {{ ((comp.nerfed_units_en or comp.nerfed_units) + (comp.nerfed_traits_en or comp.nerfed_traits)) | join(', ') }}</span>
                    </span>
                    {% endif %}
                  </div>
                </div>
              </div>

              <!-- Middle: Board Units & Mini BiS Item Strip -->
              <div class="flex flex-wrap items-start gap-2">
                {% for unit in comp.units %}
                <div class="relative group flex flex-col items-center w-[52px]">
                  <div class="relative w-11 h-11 rounded-md overflow-hidden border-2 cost-{{ unit.cost }} bg-slate-900">
                    <img src="{{ unit.icon }}" alt="{{ unit.name }}" loading="lazy"
                         onerror="this.style.display='none'"
                         class="w-full h-full object-cover" />
                    {% if unit.is_three_star %}
                    <span class="absolute top-0 left-0 bg-amber-400 text-zinc-950 text-[9px] font-bold px-1 rounded-br mono">3★</span>
                    {% elif unit.is_carry %}
                    <span class="absolute top-0 left-0 bg-zinc-100 text-zinc-950 text-[8px] font-bold px-1 rounded-br">
                      <span class="lang-tr">C</span><span class="lang-en">C</span>
                    </span>
                    {% endif %}
                    {% if unit.status == 'BUFF' %}
                    <span class="absolute bottom-0 right-0 bg-emerald-500 text-zinc-950 text-[9px] font-bold px-1 rounded-tl mono">+</span>
                    {% elif unit.status == 'NERF' %}
                    <span class="absolute bottom-0 right-0 bg-rose-500 text-white text-[9px] font-bold px-1 rounded-tl mono">&minus;</span>
                    {% endif %}
                  </div>
                  {% if unit.bis_items %}
                  <div class="flex items-center justify-center gap-0.5 -mt-1.5 z-10 bg-[#0d121c] px-1 py-0.5 rounded border border-slate-700/80 shadow">
                    {% for item in unit.bis_items[:3] %}
                    <img src="{{ item.icon }}" alt="{{ item.name }}" title="{{ item.name }} / {{ item.name_en }}"
                         onerror="this.style.display='none'"
                         class="w-3.5 h-3.5 rounded-sm object-cover" />
                    {% endfor %}
                  </div>
                  {% endif %}
                  <span class="text-[10px] text-slate-300 mt-1 max-w-[52px] truncate text-center">
                    <span class="lang-tr">{{ unit.name }}</span>
                    <span class="lang-en">{{ unit.name_en or unit.name }}</span>
                  </span>
                </div>
                {% endfor %}
              </div>

              <!-- Right: Master+ Telemetry Columns -->
              <div class="grid grid-cols-4 gap-4 border-t xl:border-t-0 pt-3 xl:pt-0 border-[#222d42] shrink-0 min-w-[230px]">
                <div class="text-right">
                  <p class="text-[10px] uppercase tracking-wider text-slate-400">
                    <span class="lang-tr">Ort. Sıra</span><span class="lang-en">Avg Place</span>
                  </p>
                  <p class="text-sm font-bold mono mt-0.5 {% if comp.master_stats.avg_placement <= 4.20 %}text-emerald-400{% elif comp.master_stats.avg_placement <= 4.45 %}text-white{% else %}text-rose-400{% endif %}">
                    #{{ comp.master_stats.avg_placement }}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-[10px] uppercase tracking-wider text-slate-400">Top 4</p>
                  <p class="text-sm font-bold text-slate-100 mono mt-0.5">{{ comp.master_stats.top4_rate }}%</p>
                </div>
                <div class="text-right">
                  <p class="text-[10px] uppercase tracking-wider text-slate-400">
                    <span class="lang-tr">1.lik</span><span class="lang-en">Win %</span>
                  </p>
                  <p class="text-sm font-bold text-[#f0c374] mono mt-0.5">{{ comp.master_stats.win_rate }}%</p>
                </div>
                <div class="text-right">
                  <p class="text-[10px] uppercase tracking-wider text-slate-400">
                    <span class="lang-tr">Örneklem</span><span class="lang-en">Sample</span>
                  </p>
                  <p class="text-xs font-semibold text-slate-300 mono mt-1">{{ "{:,}".format(comp.master_stats.sample_size) }}</p>
                </div>
              </div>

            </div>

            <!-- Carry Best-in-Slot (BiS) Items Strip + Action Buttons (Board Drawer & Copy Comp) -->
            <div class="mt-3 pt-2.5 border-t border-[#222d42] flex flex-col lg:flex-row lg:items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-2.5">
                {% if comp.carry_builds %}
                <span class="text-slate-400 font-medium text-[11px]">
                  <span class="lang-tr">Taşıyıcı Eşyaları (BiS):</span>
                  <span class="lang-en">Carry BiS Items:</span>
                </span>
                {% for cb in comp.carry_builds %}
                <div class="flex flex-wrap items-center gap-1.5 bg-[#0d121c] px-2.5 py-1 rounded border border-[#222d42]">
                  <img src="{{ cb.unit_icon }}" alt="{{ cb.unit_name }}" class="w-4 h-4 rounded-sm border cost-{{ cb.unit_cost }} object-cover" onerror="this.style.display='none'" />
                  <span class="font-semibold text-slate-100 text-[11px]">
                    <span class="lang-tr">{{ cb.unit_name }}:</span>
                    <span class="lang-en">{{ cb.unit_name_en }}:</span>
                  </span>
                  <div class="flex flex-wrap items-center gap-1">
                    {% for item in cb['items'] %}
                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-[#182030] border border-[#29364f] text-slate-200">
                      {% if item.icon %}
                      <img src="{{ item.icon }}" alt="{{ item.name }}" class="w-3.5 h-3.5 rounded-sm object-cover" onerror="this.style.display='none'" />
                      {% endif %}
                      <span class="lang-tr text-[11px]">{{ item.name }}</span>
                      <span class="lang-en text-[11px]">{{ item.name_en }}</span>
                    </span>
                    {% endfor %}
                  </div>
                </div>
                {% endfor %}
                {% endif %}
              </div>

              <!-- Action Buttons: Expand 4x7 Hex Board & 1-Click Copy Comp -->
              <div class="flex items-center gap-2 shrink-0 self-end lg:self-auto">
                <button type="button" onclick="toggleCompDrawer('comp-drawer-{{ loop.index }}', this)"
                  class="px-2.5 py-1 rounded bg-[#182030] hover:bg-slate-800 border border-[#29364f] text-slate-100 font-semibold text-[11px] transition-colors flex items-center gap-1.5">
                  <span class="text-[#f0c374]">&#9638;</span>
                  <span class="lang-tr">Tahta Dizilimi &amp; Rehber</span>
                  <span class="lang-en">4&times;7 Board &amp; Guide</span>
                </button>

                <button type="button"
                  data-team-code="{{ comp.team_planner_code }}"
                  title="TFT Team Planner Code: {{ comp.team_planner_code }}"
                  onclick="copyCompSummary(this)"
                  class="px-2.5 py-1 rounded bg-[#0d121c] hover:bg-slate-800 border border-[#222d42] hover:border-[#f0c374]/50 text-[#f0c374] font-semibold text-[11px] transition-colors">
                  <span class="lang-tr">Takım Kodu Kopyala</span>
                  <span class="lang-en">Copy Team Code</span>
                </button>
              </div>
            </div>

            <!-- EXPANDABLE DRAWER: 4x7 HEX BOARD POSITIONING & LEVELING GUIDE -->
            {% if comp.board_grid %}
            <div id="comp-drawer-{{ loop.index }}" class="hidden mt-4 pt-4 border-t border-[#222d42] grid grid-cols-1 lg:grid-cols-12 gap-5">

              <!-- Left (7 cols): 4x7 TFT Hexagonal Board Positioning Grid -->
              <div class="lg:col-span-7 bg-[#0d121c] border border-[#222d42] rounded-xl p-4">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold text-slate-100 uppercase tracking-wider">
                    <span class="lang-tr">4&times;7 Tahta Dizilimi (Üst: Ön Saf / Alt: Arka Saf)</span>
                    <span class="lang-en">4&times;7 Board Positioning (Top: Frontline / Bottom: Backline)</span>
                  </span>
                  <span class="text-[11px] text-slate-400 mono">28 Hex</span>
                </div>

                <div class="space-y-2 overflow-x-auto pb-1">
                  {% for row in comp.board_grid %}
                  {% set row_idx = loop.index0 %}
                  <div class="flex items-center gap-2 {% if row_idx % 2 == 1 %}pl-5 sm:pl-6{% endif %}">
                    <span class="text-[10px] text-slate-400 mono w-8 shrink-0">
                      <span class="lang-tr">Sıra {{ row_idx + 1 }}</span>
                      <span class="lang-en">Row {{ row_idx + 1 }}</span>
                    </span>
                    {% for cell in row %}
                    {% if cell %}
                    <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-lg border-2 cost-{{ cell.cost }} bg-slate-900 flex flex-col items-center justify-center shrink-0 shadow-md"
                         title="{{ cell.name }} / {{ cell.name_en }}">
                      <img src="{{ cell.icon }}" alt="{{ cell.name }}" class="w-full h-full object-cover rounded-[6px]" onerror="this.style.display='none'" />
                      {% if cell.is_three_star %}
                      <span class="absolute -top-1.5 -right-1 bg-amber-400 text-zinc-950 text-[8px] font-bold px-1 rounded mono">3★</span>
                      {% elif cell.is_carry %}
                      <span class="absolute -top-1.5 -right-1 bg-[#f0c374] text-zinc-950 text-[8px] font-bold px-1 rounded mono">C</span>
                      {% endif %}
                      <span class="absolute bottom-0 inset-x-0 bg-black/80 text-[8px] text-white text-center truncate px-0.5 rounded-b">
                        <span class="lang-tr">{{ cell.name }}</span>
                        <span class="lang-en">{{ cell.name_en or cell.name }}</span>
                      </span>
                    </div>
                    {% else %}
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg border border-dashed border-[#222d42] bg-[#121722]/60 shrink-0"></div>
                    {% endif %}
                    {% endfor %}
                  </div>
                  {% endfor %}
                </div>
              </div>

              <!-- Right (5 cols): Stage-by-Stage Leveling Schedule & Early Opener -->
              <div class="lg:col-span-5 flex flex-col justify-between gap-4 bg-[#0d121c] border border-[#222d42] rounded-xl p-4">
                <div>
                  <h5 class="text-xs font-bold text-slate-100 uppercase tracking-wider mb-2.5">
                    <span class="lang-tr">Aşama &amp; Seviye Basma Temposu ({{ comp.levelling }})</span>
                    <span class="lang-en">Stage Leveling &amp; Roll Schedule ({{ comp.levelling }})</span>
                  </h5>
                  <div class="space-y-1.5 text-xs">
                    {% for step in comp.level_schedule %}
                    <div class="flex items-center justify-between gap-2 py-1.5 px-2.5 rounded bg-[#161e2e] border border-[#222d42]">
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[#f0c374] font-bold mono text-[11px]">{{ step.stage }}</span>
                        <span class="font-bold text-white mono text-[11px]">{{ step.level }}</span>
                      </div>
                      <span class="text-slate-300 text-[11px] text-right">
                        <span class="lang-tr">{{ step.note_tr }}</span>
                        <span class="lang-en">{{ step.note_en }}</span>
                      </span>
                    </div>
                    {% endfor %}
                  </div>
                </div>

                {% if comp.early_units %}
                <div class="pt-3 border-t border-[#222d42]">
                  <span class="text-[11px] font-semibold text-slate-300 block mb-2">
                    <span class="lang-tr">Önerilen Aşama 2 (Lvl 4) Erken Geçiş Tahtası:</span>
                    <span class="lang-en">Recommended Stage 2 (Lvl 4) Opener Board:</span>
                  </span>
                  <div class="flex items-center gap-2.5">
                    {% for eu in comp.early_units %}
                    <div class="flex items-center gap-1.5 bg-[#161e2e] px-2 py-1 rounded border border-[#29364f]">
                      <img src="{{ eu.icon }}" alt="{{ eu.name }}" class="w-5 h-5 rounded-sm border cost-{{ eu.cost }} object-cover" onerror="this.style.display='none'" />
                      <span class="text-[11px] text-slate-100 font-medium">
                        <span class="lang-tr">{{ eu.name }}</span>
                        <span class="lang-en">{{ eu.name_en or eu.name }}</span>
                      </span>
                    </div>
                    {% endfor %}
                  </div>
                </div>
                {% endif %}

                {% if comp.team_planner_code %}
                <div class="pt-3 border-t border-[#222d42]">
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[11px] font-semibold text-slate-300">
                      <span class="lang-tr">Oyun İçi Takım Planlayıcı Kodu (TFT İstemcisi):</span>
                      <span class="lang-en">In-Game Team Planner Code (TFT Client Import):</span>
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
                    <code class="flex-1 bg-[#161e2e] border border-[#29364f] rounded px-2.5 py-1.5 text-[11px] text-[#f0c374] mono select-all overflow-x-auto whitespace-nowrap">{{ comp.team_planner_code }}</code>
                    <button type="button"
                      data-team-code="{{ comp.team_planner_code }}"
                      onclick="copyCompSummary(this)"
                      class="px-2.5 py-1.5 rounded bg-[#182030] hover:bg-slate-800 border border-[#29364f] text-slate-100 font-semibold text-[11px] shrink-0 transition-colors">
                      <span class="lang-tr">Kodu Kopyala</span>
                      <span class="lang-en">Copy Code</span>
                    </button>
                  </div>
                </div>
                {% endif %}
              </div>

            </div>
            {% endif %}

          </div>
          {% endfor %}
        </div>
      </section>

      <!-- ================================================================= -->
      <!-- AD SLOT 2: MID-PAGE IN-FEED BANNER (728x90 / 970x90)              -->
      <!-- ================================================================= -->
      <aside id="ad-slot-infeed-mid" aria-label="Sponsored Placement" class="ad-slot-container rounded-lg p-3 flex flex-col items-center justify-center min-h-[90px] text-center">
        <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mb-1">
          <span class="lang-tr">Sponsor / Reklam Alanı &bull; İçerik Arası Banner (970&times;90 / 728&times;90)</span>
          <span class="lang-en">Sponsored Placement &bull; Mid-Content Banner (970&times;90 / 728&times;90)</span>
        </span>
        <p class="text-xs text-slate-400 max-w-lg">
          <span class="lang-tr">Meta kompozisyonları ile CDragon yama değişiklikleri arasındaki yüksek görünürlüklü reklam alanı.</span>
          <span class="lang-en">High-visibility mid-page ad container between Meta Compositions and CDragon Patch Diffs.</span>
        </p>
      </aside>

      <!-- Champion Patch Diffs Section -->
      <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">
              <span class="lang-tr">Set 18 Şampiyon Yama Değişiklikleri ({{ report.versions.previous_label }} &rarr; {{ report.versions.latest_label }})</span>
              <span class="lang-en">Set 18 Champion Balance Changes ({{ report.versions.previous_label }} &rarr; {{ report.versions.latest_label }})</span>
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">
              <span class="lang-tr">CommunityDragon JSON dosyalarından matematiksel olarak çıkarılan temel nitelik ve 1/2/3 yıldız yetenek farkları</span>
              <span class="lang-en">Base stat and 1/2/3-star ability scaling diffs extracted mathematically from CommunityDragon JSON files</span>
            </p>
          </div>
          <div class="inline-flex rounded-lg bg-[#121722] p-1 border border-[#222d42] text-xs gap-1">
            <button onclick="filterChamps('ALL')" class="px-2.5 py-1 rounded font-semibold bg-zinc-200 text-zinc-950">
              <span class="lang-tr">Tümü ({{ report.live_diff.champion_diffs | length }})</span>
              <span class="lang-en">All ({{ report.live_diff.champion_diffs | length }})</span>
            </button>
            <button onclick="filterChamps('BUFF')" class="px-2.5 py-1 rounded font-semibold text-emerald-400 hover:bg-slate-800/70">
              Buff ({{ report.live_diff.summary_counts.buffed_champions }})
            </button>
            <button onclick="filterChamps('NERF')" class="px-2.5 py-1 rounded font-semibold text-rose-400 hover:bg-slate-800/70">
              Nerf ({{ report.live_diff.summary_counts.nerfed_champions }})
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" id="live-champ-grid">
          {% for champ in report.live_diff.champion_diffs %}
          <div data-status="{{ champ.status }}" class="champ-card surface-card rounded-xl p-4">
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <img src="{{ champ.icon }}" alt="{{ champ.name }}" class="w-11 h-11 rounded-md border-2 cost-{{ champ.cost }} object-cover bg-slate-900" onerror="this.style.display='none'" />
                <div>
                  <div class="flex items-center gap-2">
                    <h4 class="font-bold text-white text-sm">
                      <span class="lang-tr">{{ champ.name }}</span>
                      <span class="lang-en">{{ champ.name_en or champ.name }}</span>
                    </h4>
                    <span class="text-[11px] px-1.5 py-0.5 rounded bg-[#182030] text-slate-300 border border-[#29364f] mono">
                      {{ champ.cost }}G
                    </span>
                  </div>
                  <p class="text-xs text-slate-400 mt-0.5">{{ champ.traits | join(' · ') }}</p>
                </div>
              </div>
              <div class="text-right">
                <span class="px-2 py-0.5 rounded text-xs font-bold mono
                  {% if champ.status == 'BUFF' %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/25
                  {% elif champ.status == 'NERF' %}bg-rose-500/10 text-rose-400 border border-rose-500/25
                  {% else %}bg-amber-500/10 text-amber-400 border border-amber-500/25{% endif %}">
                  {{ champ.status }} ({{ '%+.1f'|format(champ.impact_score) }})
                </span>
              </div>
            </div>

            <div class="space-y-1 border-t border-[#222d42] pt-2.5 text-xs">
              {% for chg in champ.changes %}
              <div class="flex items-center justify-between py-1 px-2 rounded bg-[#0d121c]">
                <span class="text-slate-300">
                  <span class="lang-tr">{{ chg.label }}</span>
                  <span class="lang-en">{{ chg.label_en or chg.label }}</span>
                </span>
                <div class="flex items-center gap-2 mono">
                  <span class="text-slate-400 line-through">{{ chg.old }}</span>
                  <span class="text-slate-400">&rarr;</span>
                  <span class="font-semibold {% if chg.type == 'BUFF' %}text-emerald-400{% else %}text-rose-400{% endif %}">{{ chg.new }}</span>
                  <span class="text-[11px] px-1.5 py-0.2 rounded {% if chg.type == 'BUFF' %}bg-emerald-500/10 text-emerald-400{% else %}bg-rose-500/10 text-rose-400{% endif %}">
                    {{ '%+.1f'|format(chg.delta_pct) }}%
                  </span>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
      </section>

      <!-- Trait Diffs Section -->
      {% if report.live_diff.trait_diffs %}
      <section class="space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-white">
          <span class="lang-tr">Set 18 Sinerji / Özellik (Trait) Değişiklikleri</span>
          <span class="lang-en">Set 18 Trait Balance Changes</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {% for tr in report.live_diff.trait_diffs %}
          <div class="surface-card rounded-xl p-4">
            <div class="flex items-center justify-between mb-2.5">
              <span class="font-bold text-white text-sm">
                <span class="lang-tr">{{ tr.name }}</span>
                <span class="lang-en">{{ tr.name_en or tr.name }}</span>
              </span>
              <span class="px-2 py-0.5 rounded text-xs font-bold mono {% if tr.status == 'BUFF' %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/25{% else %}bg-rose-500/10 text-rose-400 border border-rose-500/25{% endif %}">
                {{ tr.status }} ({{ '%+.1f'|format(tr.impact_score) }})
              </span>
            </div>
            <div class="space-y-1 text-xs">
              {% for chg in tr.changes %}
              <div class="flex items-center justify-between py-1 px-2 rounded bg-[#0d121c]">
                <span class="text-slate-300">{{ chg.label }}</span>
                <div class="mono">
                  <span class="text-slate-400 line-through">{{ chg.old }}</span>
                  <span class="mx-1 text-slate-400">&rarr;</span>
                  <span class="font-semibold {% if chg.type == 'BUFF' %}text-emerald-400{% else %}text-rose-400{% endif %}">{{ chg.new }}</span>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

    </div>

    <!-- ================================================================= -->
    <!-- TAB 2: PBE UPCOMING PATCH EARLY PREVIEW                           -->
    <!-- ================================================================= -->
    <div id="panel-pbe" class="space-y-8 hidden">

      <section class="surface-card rounded-xl p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-4 rounded-sm bg-amber-400"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-300">
              <span class="lang-tr">PBE Gelecek Yama Analizi ({{ report.versions.latest_label }} &rarr; {{ report.versions.pbe_label }})</span>
              <span class="lang-en">PBE Upcoming Patch Analysis ({{ report.versions.latest_label }} &rarr; {{ report.versions.pbe_label }})</span>
            </span>
          </div>
          <span class="text-xs text-slate-400">
            <span class="lang-tr">Canlı Master+ Desteleri Üzerine PBE Değişim Projeksiyonu</span>
            <span class="lang-en">PBE Balance Overlay on Live Master+ Archetypes</span>
          </span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold text-white mb-2">
          <span class="lang-tr">{{ report.ai_summary.pbe_headline }}</span>
          <span class="lang-en">{{ report.ai_summary.pbe_headline_en or report.ai_summary.pbe_headline }}</span>
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          <span class="lang-tr">{{ report.ai_summary.pbe_analysis }}</span>
          <span class="lang-en">{{ report.ai_summary.pbe_analysis_en or report.ai_summary.pbe_analysis }}</span>
        </p>
      </section>

      {% if report.pbe_diff.champion_diffs or report.pbe_diff.trait_diffs %}
      <section class="space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-white">
          <span class="lang-tr">PBE Değişikliklerinden Etkilenen Master+ Desteleri</span>
          <span class="lang-en">Master+ Compositions Impacted by PBE Changes</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          {% for comp in report.pbe_meta.compositions[:8] %}
          <div class="surface-card rounded-xl p-4 flex items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-[#182030] text-slate-200 border border-[#29364f] mono">
                  {{ comp.levelling }} &bull; {{ comp.unit_count }} <span class="lang-tr">Birim</span><span class="lang-en">Units</span>
                </span>
                <span class="text-xs font-bold mono {% if comp.comp_delta_score > 0 %}text-emerald-400{% elif comp.comp_delta_score < 0 %}text-rose-400{% else %}text-slate-300{% endif %}">
                  PBE Delta: {{ '%+.1f'|format(comp.comp_delta_score) }}
                </span>
              </div>
              <h4 class="font-bold text-white mt-1 text-sm">
                <span class="lang-tr">{{ comp.comp_name }}</span>
                <span class="lang-en">{{ comp.comp_name_en or comp.comp_name }}</span>
              </h4>
            </div>
            <div class="flex -space-x-2 shrink-0">
              {% for u in comp.units[:6] %}
              <img src="{{ u.icon }}" alt="{{ u.name }}" title="{{ u.name }}" class="w-8 h-8 rounded-full border-2 border-[#121722] bg-slate-800 object-cover" onerror="this.style.display='none'" />
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% else %}
      <div class="surface-card rounded-xl p-8 text-center space-y-2">
        <p class="text-sm font-bold text-slate-100">
          <span class="lang-tr">PBE Dalı Güncel Canlı Yama ({{ report.versions.latest_label }}) İle Senkronize</span>
          <span class="lang-en">PBE Branch Matches Live Patch ({{ report.versions.latest_label }})</span>
        </p>
        <p class="text-xs text-slate-400 max-w-xl mx-auto">
          <span class="lang-tr">CommunityDragon üzerindeki <code>pbe</code> dalında şu an <code>{{ report.versions.latest_label }}</code> yamasından farklı bir Set 18 değişikliği bulunmuyor. Yeni PBE yaması yüklendiğinde otomatik olarak burada listelenir.</span>
          <span class="lang-en">No Set 18 balance differences are currently present on the CommunityDragon <code>pbe</code> branch compared to live patch <code>{{ report.versions.latest_label }}</code>.</span>
        </p>
      </div>
      {% endif %}

    </div>

    <!-- ================================================================= -->
    <!-- TAB 3: REGIONAL CHALLENGER LEADERBOARDS (TR / EMEA / NA / KR)      -->
    <!-- ================================================================= -->
    <div id="panel-leaderboard" class="space-y-6 hidden">
      {% if report.leaderboards and report.leaderboards.regions %}
      <!-- Server Selector & Search Bar -->
      <div class="surface-card rounded-xl p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-4 rounded-sm bg-[#f0c374]"></span>
            <h2 class="text-base sm:text-lg font-bold text-white">
              <span class="lang-tr">Bölgesel Challenger Liderlik Tablosu &amp; LP Barajları</span>
              <span class="lang-en">Regional Challenger Leaderboards &amp; Promotion Cutoffs</span>
            </h2>
          </div>
          <p class="text-xs text-slate-400 mt-1">
            <span class="lang-tr">Sunuculara göre anlık zirve oyuncuları, Challenger/GM LP barajları, son 20 maç formları ve oyun stilleri</span>
            <span class="lang-en">Live regional Challenger standings, LP promotion cutoffs, recent 20-game form, and playstyle flexibility</span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Region Filter Buttons -->
          <div class="inline-flex flex-wrap rounded-lg bg-[#0d121c] p-1 border border-[#222d42] gap-1" id="lb-region-bar">
            {% for reg in report.leaderboards.regions %}
            <button data-region="{{ reg.id }}" onclick="switchLeaderboardRegion('{{ reg.id }}')"
              class="lb-region-btn px-3 py-1.5 rounded text-xs font-bold mono transition-colors {% if loop.first %}bg-[#f0c374] text-zinc-950{% else %}text-slate-300 hover:text-white hover:bg-slate-800/60{% endif %}">
              {{ reg.code }}
            </button>
            {% endfor %}
          </div>

          <!-- Player Search -->
          <input id="lb-search-input" type="text" oninput="filterLeaderboardPlayers()"
            placeholder="Riot ID ara..."
            class="bg-[#0d121c] border border-[#222d42] focus:border-slate-500 rounded-lg px-3 py-1.5 text-xs text-slate-100 placeholder-slate-400 outline-none w-44 sm:w-52 transition-colors" />
        </div>
      </div>

      <!-- Per-Region Containers -->
      {% for reg in report.leaderboards.regions %}
      <div data-region-panel="{{ reg.id }}" class="lb-region-panel space-y-4 {% if not loop.first %}hidden{% endif %}">

        <!-- Regional Cutoffs & Server KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
          <div class="surface-card rounded-xl p-4">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
              <span class="lang-tr">{{ reg.code }} Sunucu 1.si</span>
              <span class="lang-en">{{ reg.code }} Rank #1</span>
            </p>
            <p class="text-xl sm:text-2xl font-bold text-[#f0c374] mt-1 mono">{{ "{:,}".format(reg.top_lp) }} LP</p>
            <p class="text-xs text-slate-200 font-semibold truncate mt-1">{{ reg.top_player }}</p>
          </div>

          <div class="surface-card rounded-xl p-4">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
              <span class="lang-tr">Challenger Barajı (Cutoff)</span>
              <span class="lang-en">Challenger Cutoff</span>
            </p>
            <p class="text-xl sm:text-2xl font-bold text-amber-400 mt-1 mono">{{ "{:,}".format(reg.challenger_cutoff) }} LP</p>
            <p class="text-xs text-slate-400 mt-1">
              <span class="lang-tr">{{ reg.challenger_slots }} Kontenjan ({{ reg.name_tr }})</span>
              <span class="lang-en">{{ reg.challenger_slots }} Slots ({{ reg.name_en }})</span>
            </p>
          </div>

          <div class="surface-card rounded-xl p-4">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
              <span class="lang-tr">Grandmaster Barajı (Cutoff)</span>
              <span class="lang-en">Grandmaster Cutoff</span>
            </p>
            <p class="text-xl sm:text-2xl font-bold text-white mt-1 mono">{{ "{:,}".format(reg.grandmaster_cutoff) }} LP</p>
            <p class="text-xs text-slate-400 mt-1">
              <span class="lang-tr">{{ reg.grandmaster_slots }} Kontenjan</span>
              <span class="lang-en">{{ reg.grandmaster_slots }} Slots</span>
            </p>
          </div>

          <div class="surface-card rounded-xl p-4">
            <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
              <span class="lang-tr">Toplam Master+ Oyuncu</span>
              <span class="lang-en">Master+ Population</span>
            </p>
            <p class="text-xl sm:text-2xl font-bold text-emerald-400 mt-1 mono">{{ "{:,}".format(reg.master_population) }}</p>
            <p class="text-xs text-slate-400 mt-1">
              <span class="lang-tr">Aktif Dereceli Havuzu</span>
              <span class="lang-en">Active Ranked Ladder</span>
            </p>
          </div>
        </div>

        <!-- Leaderboard Table -->
        <div class="surface-card rounded-xl overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-[#222d42] bg-[#0d121c] text-xs uppercase tracking-wider text-slate-300 font-bold">
                  <th class="py-3 px-4 w-16">
                    <span class="lang-tr">Sıra</span><span class="lang-en">Rank</span>
                  </th>
                  <th class="py-3 px-4">
                    <span class="lang-tr">Oyuncu (Riot ID)</span><span class="lang-en">Player (Riot ID)</span>
                  </th>
                  <th class="py-3 px-4">
                    <span class="lang-tr">Derece &amp; LP</span><span class="lang-en">Tier &amp; LP</span>
                  </th>
                  <th class="py-3 px-4 text-right">
                    <span class="lang-tr">Yama LP</span><span class="lang-en">Patch LP</span>
                  </th>
                  <th class="py-3 px-4 text-right">
                    <span class="lang-tr">Son 20 LP</span><span class="lang-en">Last 20 LP</span>
                  </th>
                  <th class="py-3 px-4 text-right">
                    <span class="lang-tr">Ort. Sıra</span><span class="lang-en">Avg Place</span>
                  </th>
                  <th class="py-3 px-4 text-right">
                    <span class="lang-tr">1.lik (Win%)</span><span class="lang-en">Win Rate</span>
                  </th>
                  <th class="py-3 px-4">
                    <span class="lang-tr">Oyun Stili &amp; Eşya Eğilimi</span><span class="lang-en">Playstyle &amp; Item Bias</span>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#222d42] text-xs">
                {% for p in reg.players %}
                <tr data-player-search="{{ p.riot_id | lower }}" class="lb-player-row hover:bg-[#182030] transition-colors">
                  <!-- Rank -->
                  <td class="py-3 px-4 mono font-bold">
                    {% if p.rank == 1 %}
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-amber-500/20 text-[#f0c374] border border-[#f0c374]/60 font-extrabold shadow-sm">#1</span>
                    {% elif p.rank == 2 %}
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-slate-300/20 text-white border border-slate-400/50 font-bold shadow-sm">#2</span>
                    {% elif p.rank == 3 %}
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-amber-700/25 text-amber-300 border border-amber-600/50 font-bold shadow-sm">#3</span>
                    {% else %}
                    <span class="text-slate-300 pl-1.5 font-bold">#{{ p.rank }}</span>
                    {% endif %}
                  </td>

                  <!-- Riot ID -->
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2">
                      <a href="{{ p.profile_url }}" target="_blank" rel="noopener noreferrer"
                         class="font-bold text-white hover:text-[#f0c374] transition-colors">
                        {{ p.game_name }}<span class="text-slate-400 font-normal ml-0.5">{{ p.tag_line }}</span>
                      </a>
                      <span class="px-1.5 py-0.5 text-[10px] rounded bg-[#182030] text-slate-300 border border-[#29364f] mono">{{ reg.code }}</span>
                    </div>
                  </td>

                  <!-- Tier & LP -->
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold tracking-wide bg-amber-500/10 text-[#f0c374] border border-[#f0c374]/30">
                        {{ p.tier }}
                      </span>
                      <span class="font-bold text-white mono text-sm">{{ "{:,}".format(p.lp) }} LP</span>
                    </div>
                  </td>

                  <!-- Patch LP Delta -->
                  <td class="py-3 px-4 text-right mono">
                    <span class="font-bold {% if p.patch_lp_change > 0 %}text-emerald-400{% elif p.patch_lp_change < 0 %}text-rose-400{% else %}text-slate-300{% endif %}">
                      {{ '%+d'|format(p.patch_lp_change) }} LP
                    </span>
                    <div class="text-[10px] text-slate-400">{{ p.patch_games }} <span class="lang-tr">maç</span><span class="lang-en">games</span></div>
                  </td>

                  <!-- Recent 20 Games LP Delta -->
                  <td class="py-3 px-4 text-right mono">
                    <span class="font-bold {% if p.recent_lp_change > 0 %}text-emerald-400{% elif p.recent_lp_change < 0 %}text-rose-400{% else %}text-slate-300{% endif %}">
                      {{ '%+d'|format(p.recent_lp_change) }} LP
                    </span>
                    <div class="text-[10px] text-slate-400">
                      <span class="lang-tr">Son 20:</span><span class="lang-en">L20:</span> #{{ p.recent_avg_place }}
                    </div>
                  </td>

                  <!-- Season Average Placement -->
                  <td class="py-3 px-4 text-right mono">
                    <span class="font-bold text-sm {% if p.avg_place <= 3.85 %}text-emerald-400{% elif p.avg_place <= 4.15 %}text-white{% else %}text-amber-400{% endif %}">
                      #{{ p.avg_place }}
                    </span>
                    <div class="text-[10px] text-slate-400">{{ p.games }} <span class="lang-tr">maç</span><span class="lang-en">games</span></div>
                  </td>

                  <!-- Win Rate -->
                  <td class="py-3 px-4 text-right mono">
                    <span class="font-bold text-[#f0c374]">{{ p.win_rate }}%</span>
                    <div class="text-[10px] text-slate-400">{{ p.wins }}W</div>
                  </td>

                  <!-- Playstyle & Item Bias -->
                  <td class="py-3 px-4">
                    <div class="flex flex-col gap-1.5 min-w-[165px]">
                      <div class="flex items-center justify-between gap-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold
                          {% if p.playstyle_code == 'FLEX' %}bg-emerald-950/70 text-emerald-300 border border-emerald-500/40
                          {% elif p.playstyle_code == 'FORCER' %}bg-amber-950/70 text-amber-300 border border-amber-500/40
                          {% else %}bg-[#182030] text-slate-200 border border-[#2b3952]{% endif %}">
                          <span class="lang-tr">{{ p.playstyle_tr }}</span>
                          <span class="lang-en">{{ p.playstyle_en }}</span>
                        </span>
                        <span class="text-[10px] text-slate-400 mono">
                          T:{{ p.item_bias.tank }}% AD:{{ p.item_bias.ad }}% AP:{{ p.item_bias.ap }}%
                        </span>
                      </div>
                      <div class="w-full h-1.5 rounded-full bg-slate-900 overflow-hidden flex">
                        <div style="width: {{ p.item_bias.tank }}%" class="bg-emerald-500/80" title="Tank Items: {{ p.item_bias.tank }}%"></div>
                        <div style="width: {{ p.item_bias.ad }}%" class="bg-amber-500/80" title="AD Items: {{ p.item_bias.ad }}%"></div>
                        <div style="width: {{ p.item_bias.ap }}%" class="bg-sky-500/80" title="AP Items: {{ p.item_bias.ap }}%"></div>
                      </div>
                    </div>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

      </div>
      {% endfor %}
      {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- TAB 4: MASTER+ ITEM & CHAMPION TIER LISTS                         -->
    <!-- ================================================================= -->
    <div id="panel-tierlist" class="space-y-6 hidden">
      {% if report.tier_lists %}
      <div class="surface-card rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-4 rounded-sm bg-[#f0c374]"></span>
            <h2 class="text-base sm:text-lg font-bold text-white">
              <span class="lang-tr">Set 18 Master+ Eşya &amp; Şampiyon Tier Listesi</span>
              <span class="lang-en">Set 18 Master+ Item &amp; Champion Tier List</span>
            </h2>
          </div>
          <p class="text-xs text-slate-400 mt-1">
            <span class="lang-tr">Erken aşamada basılabilecek en yüksek kazanma oranlı eşyalar (Slammable Items) ve yama diff puanlarıyla şampiyon sıralaması</span>
            <span class="lang-en">Highest-performing slammable items and Set 18 unit standings overlaid with CDragon patch diff scores</span>
          </p>
        </div>

        <!-- Sub-Tab Switcher: Items vs Champions -->
        <div class="inline-flex rounded-lg bg-[#0d121c] p-1 border border-[#222d42] gap-1 self-start sm:self-auto">
          <button id="btn-sub-items" onclick="switchTierSubTab('items')"
            class="px-3.5 py-1.5 rounded text-xs font-bold bg-[#f0c374] text-zinc-950 transition-colors">
            <span class="lang-tr">Eşya Tier Listesi ({{ report.tier_lists.item_tiers | length }})</span>
            <span class="lang-en">Item Tier List ({{ report.tier_lists.item_tiers | length }})</span>
          </button>
          <button id="btn-sub-units" onclick="switchTierSubTab('units')"
            class="px-3.5 py-1.5 rounded text-xs font-bold text-slate-300 hover:text-white transition-colors">
            <span class="lang-tr">Şampiyon Tier Listesi ({{ report.tier_lists.unit_tiers | length }})</span>
            <span class="lang-en">Champion Tier List ({{ report.tier_lists.unit_tiers | length }})</span>
          </button>
        </div>
      </div>

      <!-- SUB-PANEL 1: ITEM TIER LIST -->
      <div id="subpanel-items" class="surface-card rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#222d42] bg-[#0d121c] text-xs uppercase tracking-wider text-slate-300 font-bold">
                <th class="py-3 px-4 w-16">Tier</th>
                <th class="py-3 px-4">
                  <span class="lang-tr">Eşya (Item)</span><span class="lang-en">Item</span>
                </th>
                <th class="py-3 px-4 text-right">
                  <span class="lang-tr">Ort. Sıra</span><span class="lang-en">Avg Place</span>
                </th>
                <th class="py-3 px-4 text-right">
                  <span class="lang-tr">Oynanma</span><span class="lang-en">Play Rate</span>
                </th>
                <th class="py-3 px-4 text-right">
                  <span class="lang-tr">Örneklem</span><span class="lang-en">Matches</span>
                </th>
                <th class="py-3 px-4">
                  <span class="lang-tr">En İyi Kullanan Şampiyonlar</span><span class="lang-en">Best Unit Holders</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#222d42] text-xs">
              {% for it in report.tier_lists.item_tiers %}
              <tr class="hover:bg-[#182030] transition-colors">
                <td class="py-2.5 px-4 mono font-bold">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded text-xs
                    {% if it.tier == 'S' %}bg-amber-500/20 text-amber-300 border border-amber-500/50 shadow-sm
                    {% elif it.tier == 'A' %}bg-purple-500/20 text-purple-200 border border-purple-500/40 shadow-sm
                    {% elif it.tier == 'B' %}bg-blue-500/20 text-blue-200 border border-blue-500/40 shadow-sm
                    {% else %}bg-slate-800 text-slate-300 border border-slate-700{% endif %}">
                    {{ it.tier }}
                  </span>
                </td>
                <td class="py-2.5 px-4">
                  <div class="flex items-center gap-2.5">
                    <img src="{{ it.icon }}" alt="{{ it.name }}" class="w-8 h-8 rounded border border-slate-700 object-cover bg-slate-900" onerror="this.style.display='none'" />
                    <div>
                      <span class="font-bold text-white">
                        <span class="lang-tr">{{ it.name }}</span>
                        <span class="lang-en">{{ it.name_en }}</span>
                      </span>
                      {% if it.is_emblem %}
                      <span class="ml-1.5 px-1.5 py-0.5 text-[10px] rounded bg-amber-500/10 text-[#f0c374] border border-[#f0c374]/30">Emblem</span>
                      {% endif %}
                    </div>
                  </div>
                </td>
                <td class="py-2.5 px-4 text-right mono font-bold {% if it.avg_place <= 4.20 %}text-emerald-400{% elif it.avg_place <= 4.40 %}text-white{% else %}text-rose-400{% endif %}">
                  #{{ it.avg_place }}
                </td>
                <td class="py-2.5 px-4 text-right mono text-slate-200">{{ it.pick_rate }}%</td>
                <td class="py-2.5 px-4 text-right mono text-slate-300">{{ "{:,}".format(it.games) }}</td>
                <td class="py-2.5 px-4">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {% for h in it.holders %}
                    <div class="inline-flex items-center gap-1 bg-[#0d121c] px-2 py-0.5 rounded border border-[#29364f]">
                      <img src="{{ h.icon }}" alt="{{ h.name }}" class="w-4 h-4 rounded-sm border cost-{{ h.cost }} object-cover" onerror="this.style.display='none'" />
                      <span class="text-[11px] text-slate-200">
                        <span class="lang-tr">{{ h.name }}</span>
                        <span class="lang-en">{{ h.name_en }}</span>
                      </span>
                    </div>
                    {% endfor %}
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>

      <!-- SUB-PANEL 2: CHAMPION TIER LIST -->
      <div id="subpanel-units" class="surface-card rounded-xl overflow-hidden hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#222d42] bg-[#0d121c] text-xs uppercase tracking-wider text-slate-300 font-bold">
                <th class="py-3 px-4 w-16">Tier</th>
                <th class="py-3 px-4">
                  <span class="lang-tr">Şampiyon</span><span class="lang-en">Champion</span>
                </th>
                <th class="py-3 px-4">
                  <span class="lang-tr">Yama Durumu</span><span class="lang-en">Patch Status</span>
                </th>
                <th class="py-3 px-4 text-right">
                  <span class="lang-tr">Ort. Sıra</span><span class="lang-en">Avg Place</span>
                </th>
                <th class="py-3 px-4 text-right">
                  <span class="lang-tr">Oynanma</span><span class="lang-en">Play Rate</span>
                </th>
                <th class="py-3 px-4">
                  <span class="lang-tr">En İyi 3 Eşyası (BiS)</span><span class="lang-en">Top 3 Best-in-Slot Items</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#222d42] text-xs">
              {% for u in report.tier_lists.unit_tiers %}
              <tr class="hover:bg-[#182030] transition-colors">
                <td class="py-2.5 px-4 mono font-bold">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded text-xs
                    {% if u.tier == 'S' %}bg-amber-500/20 text-amber-300 border border-amber-500/50 shadow-sm
                    {% elif u.tier == 'A' %}bg-purple-500/20 text-purple-200 border border-purple-500/40 shadow-sm
                    {% elif u.tier == 'B' %}bg-blue-500/20 text-blue-200 border border-blue-500/40 shadow-sm
                    {% else %}bg-slate-800 text-slate-300 border border-slate-700{% endif %}">
                    {{ u.tier }}
                  </span>
                </td>
                <td class="py-2.5 px-4">
                  <div class="flex items-center gap-2.5">
                    <img src="{{ u.icon }}" alt="{{ u.name }}" class="w-9 h-9 rounded-md border-2 cost-{{ u.cost }} object-cover bg-slate-900" onerror="this.style.display='none'" />
                    <div>
                      <div class="flex items-center gap-1.5">
                        <span class="font-bold text-white">
                          <span class="lang-tr">{{ u.name }}</span>
                          <span class="lang-en">{{ u.name_en }}</span>
                        </span>
                        <span class="px-1.5 py-0.5 text-[10px] rounded bg-[#182030] text-slate-300 border border-[#29364f] mono">{{ u.cost }}G</span>
                      </div>
                      <p class="text-[11px] text-slate-400">{{ u.traits | join(' · ') }}</p>
                    </div>
                  </div>
                </td>
                <td class="py-2.5 px-4 mono">
                  {% if u.patch_status == 'BUFF' %}
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                    BUFF ({{ '%+.1f'|format(u.patch_impact) }})
                  </span>
                  {% elif u.patch_status == 'NERF' %}
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/25">
                    NERF ({{ '%+.1f'|format(u.patch_impact) }})
                  </span>
                  {% else %}
                  <span class="text-slate-400 text-[11px]">—</span>
                  {% endif %}
                </td>
                <td class="py-2.5 px-4 text-right mono font-bold {% if u.avg_place <= 4.22 %}text-emerald-400{% elif u.avg_place <= 4.42 %}text-white{% else %}text-rose-400{% endif %}">
                  #{{ u.avg_place }}
                </td>
                <td class="py-2.5 px-4 text-right mono text-slate-200">{{ u.pick_rate }}%</td>
                <td class="py-2.5 px-4">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    {% for bi in u.best_items %}
                    <div class="inline-flex items-center gap-1 bg-[#0d121c] px-2 py-0.5 rounded border border-[#29364f]">
                      {% if bi.icon %}
                      <img src="{{ bi.icon }}" alt="{{ bi.name }}" class="w-4 h-4 rounded-sm object-cover" onerror="this.style.display='none'" />
                      {% endif %}
                      <span class="text-[11px] text-slate-200">
                        <span class="lang-tr">{{ bi.name }}</span>
                        <span class="lang-en">{{ bi.name_en }}</span>
                      </span>
                    </div>
                    {% endfor %}
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      {% endif %}
    </div>

    <!-- ================================================================= -->
    <!-- AD SLOT 3: FOOTER MULTIPLEX / LEADERBOARD (728x90)                -->
    <!-- ================================================================= -->
    <aside id="ad-slot-footer-banner" aria-label="Sponsored Placement" class="ad-slot-container rounded-lg p-3 flex flex-col items-center justify-center min-h-[85px] text-center">
      <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mb-1">
        <span class="lang-tr">Sponsor / Reklam Alanı &bull; Alt Banner (728&times;90)</span>
        <span class="lang-en">Sponsored Placement &bull; Footer Leaderboard (728&times;90)</span>
      </span>
      <p class="text-xs text-slate-400">
        <span class="lang-tr">Sayfa sonu reklam / sponsorluk yerleşimi için ayrılmış alan.</span>
        <span class="lang-en">Reserved footer banner slot for display monetization or partner links.</span>
      </p>
    </aside>

  </main>

  <footer class="border-t border-[#222d42] mt-12 py-8 text-center text-xs text-slate-400 space-y-2">
    <p>
      <span class="lang-tr">Master+ Maç Kümeleme, Liderlik Tablosu &amp; Eşya İstatistikleri <a href="https://www.metatft.com" target="_blank" rel="noopener noreferrer" class="text-[#f0c374] hover:underline font-semibold">MetaTFT.com</a> izniyle kullanılmaktadır &bull; Yama Verileri: <a href="https://communitydragon.org" target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:underline">CommunityDragon</a> &amp; Riot Games API</span>
      <span class="lang-en">Master+ Match Clustering, Leaderboards &amp; BiS Item Telemetry courtesy of <a href="https://www.metatft.com" target="_blank" rel="noopener noreferrer" class="text-[#f0c374] hover:underline font-semibold">MetaTFT.com</a> &bull; Game Data via <a href="https://communitydragon.org" target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:underline">CommunityDragon</a> &amp; Riot Games API</span>
    </p>
    <p>TFT Set 18 Meta &amp; Patch Telemetry &bull; Automated via GitHub Actions CI/CD &bull; <a href="https://github.com/Apexq/TFT-Meta-Patch-Telemetry" class="text-slate-200 hover:text-white underline underline-offset-4">GitHub (@Apexq)</a></p>
    <p>
      <span class="lang-tr">Yapay Zeka Bilgi Bankası (RAG):</span>
      <span class="lang-en">AI Knowledge Base (RAG):</span>
      <a href="llms.txt" class="text-slate-200 hover:text-white underline underline-offset-4 mono">llms.txt</a> &bull;
      <a href="llms-full.txt" class="text-slate-200 hover:text-white underline underline-offset-4 mono">llms-full.txt</a> &bull;
      <a href="api/rag_context.json" class="text-slate-200 hover:text-white underline underline-offset-4 mono">rag_context.json</a>
    </p>
  </footer>

  <!-- ================================================================= -->
  <!-- AI COACH CHAT WIDGET (RAG via Cloudflare Worker)                   -->
  <!-- ================================================================= -->
  <button id="ai-chat-toggle" type="button" onclick="toggleAiChat()" aria-label="TFT AI Coach"
    class="fixed bottom-5 right-5 z-40 flex items-center gap-2 pl-3 pr-4 py-2.5 rounded-full bg-[#f0c374] hover:bg-[#ffd98f] text-slate-950 font-bold text-sm shadow-xl shadow-black/40 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M4.913 2.658c2.075-.27 4.19-.408 6.337-.408 2.147 0 4.262.139 6.337.408 1.922.25 3.291 1.861 3.405 3.727a4.403 4.403 0 0 0-1.032-.211 50.89 50.89 0 0 0-8.42 0c-2.358.196-4.04 2.19-4.04 4.434v4.286a4.47 4.47 0 0 0 2.433 3.984L7.28 21.53A.75.75 0 0 1 6 21v-4.03a48.527 48.527 0 0 1-1.087-.128C2.905 16.58 1.5 14.833 1.5 12.862V6.638c0-1.97 1.405-3.718 3.413-3.979Z"/><path d="M15.75 7.5c-1.376 0-2.739.057-4.086.169C10.124 7.797 9 9.103 9 10.609v4.285c0 1.507 1.128 2.814 2.67 2.94 1.243.102 2.5.157 3.768.165l2.782 2.781a.75.75 0 0 0 1.28-.53v-2.39l.33-.026c1.542-.125 2.67-1.433 2.67-2.94v-4.286c0-1.505-1.125-2.811-2.664-2.94A49.392 49.392 0 0 0 15.75 7.5Z"/></svg>
    <span class="lang-tr">AI Koç</span><span class="lang-en">AI Coach</span>
  </button>

  <section id="ai-chat-panel" aria-label="TFT AI Coach"
    class="hidden fixed bottom-20 right-3 sm:right-5 z-40 w-[calc(100vw-1.5rem)] sm:w-[400px] h-[min(600px,calc(100vh-7rem))] flex-col rounded-2xl bg-[#121722] border border-[#29364f] shadow-2xl shadow-black/60 overflow-hidden">
    <header class="flex items-center justify-between gap-2 px-4 py-3 border-b border-[#222d42] bg-[#0d121c]">
      <div>
        <p class="text-sm font-bold text-white">
          <span class="lang-tr">TFT AI Koç</span><span class="lang-en">TFT AI Coach</span>
          <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded bg-[#182030] text-[#f0c374] border border-[#29364f] mono">{{ report.versions.latest_label }}</span>
        </p>
        <p class="text-[11px] text-slate-400">
          <span class="lang-tr">Yanıtlar yalnızca bu yamanın Master+ verisinden üretilir</span>
          <span class="lang-en">Answers are grounded only in this patch's Master+ data</span>
        </p>
      </div>
      <button type="button" onclick="toggleAiChat()" class="w-8 h-8 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 text-lg leading-none" aria-label="Close">&times;</button>
    </header>

    <div id="ai-chat-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3 text-sm"></div>

    <div id="ai-chat-suggestions" class="px-4 pb-2 flex flex-wrap gap-1.5"></div>

    <form id="ai-chat-form" onsubmit="sendAiChat(event)" class="flex items-center gap-2 px-3 py-3 border-t border-[#222d42] bg-[#0d121c]">
      <input id="ai-chat-input" type="text" maxlength="500" autocomplete="off"
        class="flex-1 bg-[#121722] border border-[#29364f] focus:border-[#f0c374]/70 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-400 outline-none" />
      <button id="ai-chat-send" type="submit"
        class="px-3.5 py-2 rounded-lg bg-[#f0c374] hover:bg-[#ffd98f] text-slate-950 text-sm font-bold disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
        <span class="lang-tr">Gönder</span><span class="lang-en">Send</span>
      </button>
    </form>
  </section>

  <script>
    let activeCompFilter = 'ALL';
    let activeLbRegion = 'tr1';
    let selectedMatcherItems = new Set();

    function setLanguage(lang) {
      document.documentElement.setAttribute('data-lang', lang);
      localStorage.setItem('tft_lang', lang);
      const btnTr = document.getElementById('lang-btn-tr');
      const btnEn = document.getElementById('lang-btn-en');
      const searchInput = document.getElementById('comp-search-input');
      const lbSearchInput = document.getElementById('lb-search-input');
      if (searchInput) {
        searchInput.placeholder = lang === 'tr' ? 'Şampiyon, sinerji ara...' : 'Search unit, trait...';
      }
      if (lbSearchInput) {
        lbSearchInput.placeholder = lang === 'tr' ? 'Riot ID ara...' : 'Search Riot ID...';
      }
      if (lang === 'tr') {
        btnTr.className = 'px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors bg-slate-200 text-slate-950';
        btnEn.className = 'px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors text-slate-300 hover:text-white';
      } else {
        btnEn.className = 'px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors bg-slate-200 text-slate-950';
        btnTr.className = 'px-2.5 py-1 rounded-sm text-xs font-semibold transition-colors text-slate-300 hover:text-white';
      }
    }

    setLanguage(document.documentElement.getAttribute('data-lang') || 'tr');

    function switchTab(tab) {
      const panels = {
        live: document.getElementById('panel-live'),
        tierlist: document.getElementById('panel-tierlist'),
        leaderboard: document.getElementById('panel-leaderboard'),
        pbe: document.getElementById('panel-pbe')
      };
      const buttons = {
        live: document.getElementById('btn-tab-live'),
        tierlist: document.getElementById('btn-tab-tierlist'),
        leaderboard: document.getElementById('btn-tab-leaderboard'),
        pbe: document.getElementById('btn-tab-pbe')
      };
      Object.keys(panels).forEach(k => {
        if (!panels[k] || !buttons[k]) return;
        if (k === tab) {
          panels[k].classList.remove('hidden');
          buttons[k].className = 'px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all bg-white text-slate-950 shadow-md flex items-center gap-1.5';
        } else {
          panels[k].classList.add('hidden');
          buttons[k].className = 'px-4 py-2 rounded-md text-xs sm:text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-slate-800/60 flex items-center gap-1.5';
        }
      });
    }

    function switchTierSubTab(sub) {
      const pItems = document.getElementById('subpanel-items');
      const pUnits = document.getElementById('subpanel-units');
      const bItems = document.getElementById('btn-sub-items');
      const bUnits = document.getElementById('btn-sub-units');
      if (sub === 'items') {
        pItems.classList.remove('hidden');
        pUnits.classList.add('hidden');
        bItems.className = 'px-3.5 py-1.5 rounded text-xs font-bold bg-[#f0c374] text-slate-950 transition-colors shadow-sm';
        bUnits.className = 'px-3.5 py-1.5 rounded text-xs font-bold text-slate-300 hover:text-white transition-colors';
      } else {
        pUnits.classList.remove('hidden');
        pItems.classList.add('hidden');
        bUnits.className = 'px-3.5 py-1.5 rounded text-xs font-bold bg-[#f0c374] text-slate-950 transition-colors shadow-sm';
        bItems.className = 'px-3.5 py-1.5 rounded text-xs font-bold text-slate-300 hover:text-white transition-colors';
      }
    }

    function toggleItemMatcher(itemId) {
      if (selectedMatcherItems.has(itemId)) {
        selectedMatcherItems.delete(itemId);
      } else {
        if (selectedMatcherItems.size >= 3) {
          const first = selectedMatcherItems.values().next().value;
          selectedMatcherItems.delete(first);
        }
        selectedMatcherItems.add(itemId);
      }
      updateMatcherButtonsUI();
      applyCompFilters();
    }

    function clearSelectedItems() {
      selectedMatcherItems.clear();
      updateMatcherButtonsUI();
      applyCompFilters();
    }

    function updateMatcherButtonsUI() {
      const clearBtn = document.getElementById('clear-items-btn');
      if (clearBtn) {
        if (selectedMatcherItems.size > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
      document.querySelectorAll('#matcher-item-bar .matcher-item-btn').forEach(btn => {
        const id = btn.getAttribute('data-item-id');
        if (selectedMatcherItems.has(id)) {
          btn.className = 'matcher-item-btn group relative flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-amber-500/20 border-2 border-[#f0c374] text-white transition-all text-xs shadow-md';
        } else {
          btn.className = 'matcher-item-btn group relative flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[#0d121c] border border-slate-700/80 hover:border-slate-500 text-slate-200 hover:text-white transition-all text-xs';
        }
      });
    }

    function toggleCompDrawer(drawerId, btnEl) {
      const drawer = document.getElementById(drawerId);
      if (!drawer) return;
      drawer.classList.toggle('hidden');
      if (!drawer.classList.contains('hidden')) {
        btnEl.classList.add('border-[#f0c374]', 'text-[#f0c374]');
      } else {
        btnEl.classList.remove('border-[#f0c374]', 'text-[#f0c374]');
      }
    }

    function copyCompSummary(btnEl) {
      const lang = document.documentElement.getAttribute('data-lang') || 'tr';
      const code = btnEl.getAttribute('data-team-code') || '';
      if (navigator.clipboard && code) {
        navigator.clipboard.writeText(code);
      }
      const origHtml = btnEl.innerHTML;
      btnEl.innerHTML = lang === 'tr'
        ? '<span class="text-emerald-400">&#10003; Kod Kopyalandı!</span>'
        : '<span class="text-emerald-400">&#10003; Code Copied!</span>';
      setTimeout(() => {
        btnEl.innerHTML = origHtml;
      }, 1800);
    }

    function switchLeaderboardRegion(regionId) {
      activeLbRegion = regionId;
      document.querySelectorAll('#lb-region-bar .lb-region-btn').forEach(btn => {
        if (btn.getAttribute('data-region') === regionId) {
          btn.className = 'lb-region-btn px-3 py-1.5 rounded text-xs font-bold mono transition-colors bg-[#f0c374] text-slate-950 shadow-sm';
        } else {
          btn.className = 'lb-region-btn px-3 py-1.5 rounded text-xs font-bold mono transition-colors text-slate-300 hover:text-white hover:bg-slate-800/60';
        }
      });
      document.querySelectorAll('.lb-region-panel').forEach(panel => {
        if (panel.getAttribute('data-region-panel') === regionId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
      filterLeaderboardPlayers();
    }

    function filterLeaderboardPlayers() {
      const query = (document.getElementById('lb-search-input')?.value || '').trim().toLowerCase();
      document.querySelectorAll(`.lb-region-panel[data-region-panel="${activeLbRegion}"] .lb-player-row`).forEach(row => {
        const rid = row.getAttribute('data-player-search') || '';
        if (!query || rid.includes(query)) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }

    function filterChamps(status) {
      document.querySelectorAll('#live-champ-grid .champ-card').forEach(card => {
        if (status === 'ALL' || card.getAttribute('data-status') === status) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function filterComps(filterVal) {
      activeCompFilter = filterVal;
      document.querySelectorAll('#comp-filter-bar .comp-filter-btn').forEach(btn => {
        if (btn.getAttribute('data-filter') === filterVal) {
          btn.classList.add('bg-slate-200', 'text-slate-950');
        } else {
          btn.classList.remove('bg-slate-200', 'text-slate-950');
        }
      });
      applyCompFilters();
    }

    function applyCompFilters() {
      const query = (document.getElementById('comp-search-input')?.value || '').trim().toLowerCase();
      document.querySelectorAll('#live-comp-grid .comp-card').forEach(card => {
        const tier = card.getAttribute('data-tier');
        const status = card.getAttribute('data-status');
        const searchBlob = card.getAttribute('data-search') || '';
        const compItems = (card.getAttribute('data-items') || '').split(',');
        const matchesTier = (activeCompFilter === 'ALL' || tier === activeCompFilter || status === activeCompFilter);
        const matchesQuery = (!query || searchBlob.includes(query));
        let matchesSelectedItems = true;
        if (selectedMatcherItems.size > 0) {
          for (const reqItem of selectedMatcherItems) {
            if (!compItems.includes(reqItem)) {
              matchesSelectedItems = false;
              break;
            }
          }
        }
        if (matchesTier && matchesQuery && matchesSelectedItems) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    // ---------------------------------------------------------------
    // AI COACH CHAT (calls the Cloudflare Worker RAG proxy)
    // ---------------------------------------------------------------
    const AI_CHAT_ENDPOINT = {{ ((report.chat or {}).get('endpoint') or '') | tojson }};
    const aiChatHistory = [];
    let aiChatBusy = false;

    const AI_CHAT_TEXT = {
      tr: {
        welcome: 'Merhaba! Ben TFT AI Koç. Bu yamanın Master+ verilerine göre komp, eşya, buff/nerf ve liderlik tablosu sorularını yanıtlarım.',
        offline: 'AI Koç çok yakında aktif olacak. Bu arada kompları ve tier listelerini incelemeye devam edebilirsin.',
        placeholder: 'Örn: Elimde Guinsoo var, ne oynamalıyım?',
        thinking: 'Düşünüyor...',
        error: 'Şu an yanıt alınamadı. Lütfen biraz sonra tekrar dene.',
        limited: 'Çok hızlı soru soruyorsun, bir dakika bekleyip tekrar dene.',
        copy: 'Kodu Kopyala', copied: 'Kopyalandı!',
        suggestions: ['Şu an en güçlü komp hangisi?', 'Bu yamada kim buff aldı?', 'AP eşyalarıyla ne oynanır?', 'TR Challenger barajı kaç LP?']
      },
      en: {
        welcome: "Hi! I'm the TFT AI Coach. I answer questions about comps, items, buffs/nerfs and leaderboards using this patch's Master+ data.",
        offline: 'The AI Coach is coming soon. Meanwhile, keep exploring the comps and tier lists.',
        placeholder: 'e.g. I have Guinsoo, what should I play?',
        thinking: 'Thinking...',
        error: "Couldn't get an answer right now. Please try again shortly.",
        limited: "You're asking too fast, wait a minute and try again.",
        copy: 'Copy Code', copied: 'Copied!',
        suggestions: ['What is the strongest comp right now?', 'Who got buffed this patch?', 'What to play with AP items?', 'What is the EUW Challenger cutoff?']
      }
    };

    function aiLang() {
      return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'tr';
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }

    function renderAiText(text) {
      const t = AI_CHAT_TEXT[aiLang()];
      let html = escapeHtml(text)
        .replace(/\*\*(.+?)\*\*/g, '<strong class="text-white">$1</strong>')
        .replace(/^\s*[-*]\s+(.+)$/gm, '<span class="block pl-3 -indent-3">&bull; $1</span>')
        .replace(/\n/g, '<br>');
      html = html.replace(/\b(02[0-9a-fA-F]{6,30}TFTSet18)\b/g, (m) =>
        `<span class="inline-flex items-center gap-1.5 my-1 px-2 py-1 rounded bg-[#0d121c] border border-[#29364f]">` +
        `<code class="mono text-[11px] text-[#f0c374] break-all">${m}</code>` +
        `<button type="button" data-team-code="${m}" onclick="copyAiCode(this)" class="shrink-0 px-1.5 py-0.5 rounded bg-[#182030] text-[10px] font-semibold text-slate-100 hover:bg-slate-700">${t.copy}</button></span>`
      );
      return html;
    }

    function addAiMessage(role, text, extraClass) {
      const box = document.getElementById('ai-chat-messages');
      const wrap = document.createElement('div');
      wrap.className = role === 'user' ? 'flex justify-end' : 'flex justify-start';
      const bubble = document.createElement('div');
      bubble.className = (role === 'user'
        ? 'max-w-[85%] px-3 py-2 rounded-2xl rounded-br-sm bg-[#f0c374] text-slate-950 font-medium'
        : 'max-w-[90%] px-3 py-2 rounded-2xl rounded-bl-sm bg-[#182030] border border-[#29364f] text-slate-100 leading-relaxed') + (extraClass ? ' ' + extraClass : '');
      bubble.innerHTML = role === 'user' ? escapeHtml(text) : renderAiText(text);
      wrap.appendChild(bubble);
      box.appendChild(wrap);
      box.scrollTop = box.scrollHeight;
      return bubble;
    }

    function copyAiCode(btn) {
      const code = btn.getAttribute('data-team-code') || '';
      if (navigator.clipboard && code) navigator.clipboard.writeText(code);
      const t = AI_CHAT_TEXT[aiLang()];
      btn.textContent = t.copied;
      setTimeout(() => { btn.textContent = t.copy; }, 1600);
    }

    function initAiChat() {
      const t = AI_CHAT_TEXT[aiLang()];
      const box = document.getElementById('ai-chat-messages');
      const input = document.getElementById('ai-chat-input');
      const send = document.getElementById('ai-chat-send');
      const sugg = document.getElementById('ai-chat-suggestions');
      box.innerHTML = '';
      sugg.innerHTML = '';
      input.placeholder = t.placeholder;
      if (!AI_CHAT_ENDPOINT) {
        addAiMessage('model', t.offline);
        input.disabled = true;
        send.disabled = true;
        return;
      }
      addAiMessage('model', t.welcome);
      aiChatHistory.forEach(h => addAiMessage(h.role, h.text));
      if (aiChatHistory.length === 0) {
        t.suggestions.forEach(q => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = q;
          b.className = 'px-2.5 py-1 rounded-full bg-[#182030] border border-[#29364f] text-[11px] text-slate-200 hover:text-white hover:border-[#f0c374]/60 transition-colors';
          b.onclick = () => { input.value = q; sendAiChat(); };
          sugg.appendChild(b);
        });
      }
    }

    function toggleAiChat() {
      const panel = document.getElementById('ai-chat-panel');
      const opening = panel.classList.contains('hidden');
      panel.classList.toggle('hidden', !opening);
      panel.classList.toggle('flex', opening);
      if (opening) {
        initAiChat();
        const input = document.getElementById('ai-chat-input');
        if (!input.disabled) input.focus();
      }
    }

    async function sendAiChat(ev) {
      if (ev) ev.preventDefault();
      if (aiChatBusy || !AI_CHAT_ENDPOINT) return;
      const input = document.getElementById('ai-chat-input');
      const send = document.getElementById('ai-chat-send');
      const message = input.value.trim();
      if (!message) return;
      const t = AI_CHAT_TEXT[aiLang()];

      document.getElementById('ai-chat-suggestions').innerHTML = '';
      addAiMessage('user', message);
      input.value = '';
      aiChatBusy = true;
      send.disabled = true;
      const pending = addAiMessage('model', t.thinking, 'text-slate-400 animate-pulse');

      try {
        const res = await fetch(AI_CHAT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, lang: aiLang(), history: aiChatHistory.slice(-6) })
        });
        const data = await res.json().catch(() => ({}));
        let reply;
        if (res.status === 429) reply = t.limited;
        else if (!res.ok || !data.reply) reply = t.error;
        else {
          reply = data.reply;
          aiChatHistory.push({ role: 'user', text: message }, { role: 'model', text: reply });
        }
        pending.className = 'max-w-[90%] px-3 py-2 rounded-2xl rounded-bl-sm bg-[#182030] border border-[#29364f] text-slate-100 leading-relaxed';
        pending.innerHTML = renderAiText(reply);
      } catch (e) {
        pending.className = 'max-w-[90%] px-3 py-2 rounded-2xl rounded-bl-sm bg-[#182030] border border-rose-500/40 text-rose-200';
        pending.textContent = t.error;
      } finally {
        aiChatBusy = false;
        send.disabled = false;
        input.focus();
        const box = document.getElementById('ai-chat-messages');
        box.scrollTop = box.scrollHeight;
      }
    }
  </script>
</body>
</html>
