# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables, certificates & secrets (Never commit!)
.env
.env.*
*.pem
*.key

# Local cache & temporary raw CDragon downloads (large files)
.cache/
data/raw_cache/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases (including WAL/SHM) & collected staticfiles
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
staticfiles/

# Server & private deployment ops (not for public self-hosting)
Dockerfile
.dockerignore
docker-compose*.yml
deploy/

# Edge worker local state
.wrangler/
worker/.wrangler/

# Internal agent & OS artifacts
.agents/
handoff.md
*.log
nul
